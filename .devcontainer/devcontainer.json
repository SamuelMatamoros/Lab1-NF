{
    "postCreateCommand": "python -m pip install --upgrade numpy ipykernel nbstripout && nbstripout --install --attributes .gitattributes",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "donjayamanne.vscode-default-python-kernel"
            ],
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
            }
        }
    }
}